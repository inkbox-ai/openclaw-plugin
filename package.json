{
  "name": "@inkbox/inkbox",
  "version": "0.2.19",
  "description": "Inkbox plugin for OpenClaw \u2014 adds email, SMS, iMessage, WhatsApp, Slack, voice, and A2A tools with inbound webhook handling",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "REMOTE_TOOLS.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inkbox/sdk": ">=0.7.38 <1.0.0",
    "json5": "^2.2.3",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.1.38",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "openclaw": ">=2026.5.27",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.27"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "inkbox",
      "label": "Inkbox",
      "selectionLabel": "Inkbox (Email, SMS, iMessage, WhatsApp, Slack, Voice)",
      "detailLabel": "Inkbox",
      "docsPath": "/plugins/inkbox",
      "docsLabel": "inkbox",
      "blurb": "Inkbox email, SMS, iMessage, WhatsApp, Slack, and voice identities.",
      "order": 90,
      "aliases": [
        "email",
        "sms",
        "phone",
        "imessage",
        "whatsapp"
      ],
      "markdownCapable": false,
      "exposure": {
        "configured": true,
        "setup": true,
        "docs": true
      },
      "cliAddOptions": [
        {
          "flags": "--identity <handle>",
          "description": "Inkbox agent identity handle"
        },
        {
          "flags": "--public-url <url>",
          "description": "Public OpenClaw URL for Inkbox webhooks"
        },
        {
          "flags": "--tunnel-name <name>",
          "description": "Inkbox tunnel name"
        },
        {
          "flags": "--allowed-recipient <target>",
          "description": "Allowed outbound recipient (repeatable)"
        },
        {
          "flags": "--allowed-inbound-contact <id>",
          "description": "Allowed inbound Inkbox contact id (repeatable)"
        }
      ]
    },
    "compat": {
      "pluginApi": ">=2026.5.27",
      "minGatewayVersion": "2026.5.27"
    },
    "build": {
      "openclawVersion": "2026.5.27",
      "pluginSdkVersion": "2026.5.27"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "@inkbox/sdk": "github:inkbox-ai/inkbox#5ebde74b33bd560e9c9818f675ff0c5c6f1cb962&path:/sdk/typescript"
    }
  }
}
